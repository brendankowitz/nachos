---
import DefaultContentPanel from '@astrojs/starlight/components/ContentPanel.astro';
---

<DefaultContentPanel>
  {Astro.url.pathname.includes('/reference/rest-api') && (
    <aside aria-label="Declaration evidence only">
      <strong>API declarations, not operational conformance.</strong>
      SDK conformance: not-run. Authentication: not-assessed.
      Routes declaring 501 are staged; mixed 2xx/501 routes are partial.
      Autogenerated REST code examples are disabled; use these pages for declarations, not tested commands.
    </aside>
  )}
  <slot />
</DefaultContentPanel>
