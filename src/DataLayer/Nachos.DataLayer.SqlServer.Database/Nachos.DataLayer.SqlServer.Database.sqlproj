<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.2.0" />
  <PropertyGroup>
    <!-- The pinned SDK otherwise checks NuGet for a newer version on every restore and warns when one exists; with
         warnings as errors that makes builds depend on the feed's current state. Upgrades are deliberate pin changes. -->
    <SkipCheckForNewSDKVersion>true</SkipCheckForNewSDKVersion>
    <Name>Nachos.DataLayer.SqlServer.Database</Name>
    <!-- Azure SQL Database is the production target. DacFx treats it as its own platform, so a
         dacpac built for a Sql1xx provider cannot be published to it. The Sql2025 sibling project
         builds the same DDL for box SQL Server 2025. -->
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <!-- Database options. A deploy to an empty database applies every option the model declares, and the Microsoft.Build.Sql
         defaults are not what a new Azure SQL Database has, so the ones that matter are declared here. Azure's own defaults are
         the target: the first deploy to a new Azure database must not switch anything off. Documented General Purpose defaults:
         READ_COMMITTED_SNAPSHOT ON, ALLOW_SNAPSHOT_ISOLATION ON, MAXDOP 8, PAGE_VERIFY CHECKSUM, TARGET_RECOVERY_TIME 60,
         Query Store READ_WRITE/AUTO. The Sql2025 sibling declares the values of a new SQL Server 2025 database instead (probed
         in the Testcontainers image), which differ (snapshot isolation off, MAXDOP 0); do not copy one project's values to the other.
         The ANSI, cursor and Query Store capture settings below are the box values; Azure was not probed (Azure is owner-gated).
         DatabaseOptionsTests pins what this project declares. -->
    <ReadCommittedSnapshot>True</ReadCommittedSnapshot>
    <AllowSnapshotIsolation>True</AllowSnapshotIsolation>
    <DbScopedConfigMaxDOP>8</DbScopedConfigMaxDOP>
    <PageVerify>CHECKSUM</PageVerify>
    <TargetRecoveryTimePeriod>60</TargetRecoveryTimePeriod>
    <TargetRecoveryTimeUnit>SECONDS</TargetRecoveryTimeUnit>
    <ServiceBrokerOption>EnableBroker</ServiceBrokerOption>
    <AnsiNullDefault>False</AnsiNullDefault>
    <AnsiNulls>False</AnsiNulls>
    <AnsiPadding>False</AnsiPadding>
    <AnsiWarnings>False</AnsiWarnings>
    <ArithAbort>False</ArithAbort>
    <ConcatNullYieldsNull>False</ConcatNullYieldsNull>
    <QuotedIdentifier>False</QuotedIdentifier>
    <DefaultCursor>GLOBAL</DefaultCursor>
    <QueryStoreDesiredState>ReadWrite</QueryStoreDesiredState>
    <QueryStoreCaptureMode>Auto</QueryStoreCaptureMode>
    <QueryStoreStaleQueryThreshold>30</QueryStoreStaleQueryThreshold>
    <!-- Azure's default varies by service tier (10, 100 or 1024 MB; the cap is 10,240). 1024 is the largest default, and a tier
         with a lower cap is expected to accept it (not probed: Azure is owner-gated). The DacFx Azure provider accepts it at build. -->
    <QueryStoreMaxStorageSize>1024</QueryStoreMaxStorageSize>
    <QueryStoreFlushInterval>900</QueryStoreFlushInterval>
    <QueryStoreStatsInterval>60</QueryStoreStatsInterval>
    <QueryStoreMaxPlansPerQuery>200</QueryStoreMaxPlansPerQuery>
    <TreatTSqlWarningsAsErrors>true</TreatTSqlWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Build Remove="Scripts\Script.PostDeployment.sql" />
    <PostDeploy Include="Scripts\Script.PostDeployment.sql" />
  </ItemGroup>
</Project>