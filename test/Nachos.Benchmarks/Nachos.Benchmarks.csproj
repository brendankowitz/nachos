<Project Sdk="Microsoft.NET.Sdk">

  <!-- A console app run by hand (see README.md): it starts its own SQL Server container and seeds up to a million messages,
       so it is built with the solution but never run by `dotnet test` or any CI lane. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Testcontainers.MsSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nachos.Hosting\Nachos.Hosting.csproj" />
    <ProjectReference Include="..\..\src\DataLayer\Nachos.DataLayer.SqlServer\Nachos.DataLayer.SqlServer.csproj" />
  </ItemGroup>
</Project>
